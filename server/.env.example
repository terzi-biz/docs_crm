PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret

# AI estimate analysis — used as a fallback ONLY when the regular parser's
# confidence is low (non-standard layout, scanned text, etc). Without a key
# the app still works via the regular parser alone.
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
